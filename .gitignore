# ---------------------------------------------
# Unity
# ---------------------------------------------
# Carpetas generadas por Unity: NO deben subirse.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Los .meta solo se ignoran si su asset tambien esta ignorado.
!/[Aa]ssets/**/*.meta

# Plugin autogenerado de JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*

# Caches de IDE
.vs/
.idea/
.gradle/

# Soluciones y proyectos autogenerados
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# Informe de crash de Unity
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables empaquetados
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Archivos del sistema operativo
.DS_Store
Thumbs.db
